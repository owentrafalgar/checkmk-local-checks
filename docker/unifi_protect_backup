#!/bin/bash
# Checkmk local check: UniFi Protect Backup - download/upload failures
#
# Uses piggyback so the service shows up under the dedicated
# 'unifi-protect-backup' host instead of the 'docker' host.
# Must live directly under local/ (no numbered interval subfolder) -
# piggyback markers are lost when Checkmk caches numbered-folder scripts.
#
# Timestamps use the 'Z' (UTC) suffix explicitly - without it, the Docker
# daemon appears to interpret the timestamp as local time and shifts the
# actual filter window by the local UTC offset.

CONTAINER_NAME="unifi-protect-backup"
PIGGYBACK_HOST="unifi-protect-backup"
SERVICE="UniFi Protect Backup"
STATE_FILE="/var/lib/check_mk_agent/unifi_protect_backup_last_check"

mkdir -p "$(dirname "$STATE_FILE")"

# On first run, only look back 1 hour to avoid flagging old, already-known issues
if [ -f "$STATE_FILE" ]; then
    SINCE=$(cat "$STATE_FILE")
else
    SINCE=$(date -u -d '1 hour ago' '+%Y-%m-%dT%H:%M:%SZ')
fi
NOW=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

LOG_OUTPUT=$(docker logs --since "$SINCE" --until "$NOW" "$CONTAINER_NAME" 2>&1)
echo "$NOW" > "$STATE_FILE"

# Only match failures reported by the downloader/uploader modules themselves,
# not unrelated ERROR lines (e.g. websocket reconnects, which are self-healing)
FAILED_DOWNLOADS=$(echo "$LOG_OUTPUT" | grep -cE 'unifi_protect_backup\.downloader\s*:.*Failed download attempt')
FAILED_UPLOADS=$(echo "$LOG_OUTPUT" | grep -cE 'unifi_protect_backup\.uploader\s*:.*(Failed|Error)')
SUCCESSFUL_UPLOADS=$(echo "$LOG_OUTPUT" | grep -cE 'unifi_protect_backup\.uploader\s*:.*\bUploaded\b')

TOTAL_FAILURES=$((FAILED_DOWNLOADS + FAILED_UPLOADS))
PERF="failed_downloads=${FAILED_DOWNLOADS} failed_uploads=${FAILED_UPLOADS} successful_uploads=${SUCCESSFUL_UPLOADS}"

if [ "$TOTAL_FAILURES" -gt 0 ]; then
    LAST_FAIL=$(echo "$LOG_OUTPUT" | grep -E 'unifi_protect_backup\.(downloader|uploader)\s*:.*(Failed|Error)' | tail -1 | sed 's/^[0-9-]* [0-9:]* //' | cut -c1-250)
    RESULT_LINE="2 \"$SERVICE\" $PERF - ${TOTAL_FAILURES} failed download(s)/upload(s). Last: ${LAST_FAIL}"
else
    RESULT_LINE="0 \"$SERVICE\" $PERF - ${SUCCESSFUL_UPLOADS} successful uploads, no failures"
fi

echo "<<<<${PIGGYBACK_HOST}>>>>"
echo "<<<local:sep(0)>>>"
echo "$RESULT_LINE"
echo "<<<<>>>>"
